# Local development environment variables

# Database (defaults work with docker-compose)
POSTGRES_USER=claudetorio
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=claudetorio

# Factorio RCON
RCON_PASSWORD=dev_rcon_password

# Optional: Anthropic API key for running agents locally
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Stream client password
STREAM_PASSWORD=dev123

# OAuth (GitHub) — required for user sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_SECRET=dev-secret-change-this-in-production-at-least-32-chars
