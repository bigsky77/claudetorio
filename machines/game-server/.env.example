# PostgreSQL
POSTGRES_PASSWORD=change_me_in_production

# Factorio RCON
RCON_PASSWORD=change_me_in_production
FACTORIO_IMAGE=factoriotools/factorio:stable

# Two-server deployment: shared secret between broker and stream-agent
STREAM_AGENT_KEY=change_me_in_production

# Caddy wildcard subdomain domain for streams (production).
# When set, broker generates https://c{slot}.{STREAM_DOMAIN}/ URLs (served by stream-server Caddy).
# When empty (default for local dev), broker uses port-based URLs: http://localhost:{PORT}/.
STREAM_DOMAIN=stream.claudetorio.ai

# Optional: Anthropic API key for agents
ANTHROPIC_API_KEY=sk-ant-...

# Stream server networking (defaults to production values if unset)
# Override for local VM testing (set to localhost or 10.0.2.2 for cross-VM routing)
STREAM_AGENT_URL=http://localhost:8090
GAME_SERVER_PUBLIC_HOST=localhost
STREAM_SERVER_PUBLIC_HOST=localhost
STREAM_URL=http://localhost
STREAM_PUBLIC_HOST=localhost
NEXT_PUBLIC_API_URL=https://app.claudetorio.ai
NEXT_PUBLIC_STREAM_URL=https://stream.claudetorio.ai

# Replay delay between stream-client start and stream-worker spawn (seconds)
STREAM_CLIENT_SETTLE_TIME=20

# ElevenLabs TTS for narration
ELEVENLABS_API_KEY=

# RTMP stream keys for live pushing
TWITCH_STREAM_KEY=
KICK_STREAM_KEY=

# Twitch API and channel
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=

# Twitch embed parent domain (must match the domain serving the frontend)
NEXT_PUBLIC_TWITCH_EMBED_PARENT=app.claudetorio.ai

# GitHub OAuth (required for login widget)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://app.claudetorio.ai/auth/callback
JWT_SECRET=
