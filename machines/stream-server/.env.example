# Stream viewer password
STREAM_PASSWORD=change_me_in_production

# Domain for TLS certificate (Caddy will auto-obtain from Let's Encrypt)
# Example: stream.claudetorio.dev
STREAM_DOMAIN=stream.localhost

# Two-server deployment: shared secret between broker and stream-agent
STREAM_AGENT_KEY=change_me_in_production

# Path to Factorio client installation on this host (for factorio-client-init volume)
FACTORIO_CLIENT_PATH=/opt/factorio
