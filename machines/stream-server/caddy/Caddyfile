# ClaudeTorio Stream Server - Caddy Reverse Proxy Configuration
#
# This Caddyfile terminates TLS and proxies to KasmVNC stream clients.
# Uses on-demand TLS so Caddy issues individual certs per subdomain
# (c0, c1, cr0, ...) via HTTP-01/TLS-ALPN-01 — no DNS-01 needed.

{
	email admin@claudetorio.dev

	# On-demand TLS: issue individual certs per connecting hostname.
	# The ask endpoint validates hostnames — stream-agent /health always
	# returns 200, which is fine since we control all subdomains.
	on_demand_tls {
		ask http://stream-agent:8090/health
		interval 1m
		burst 20
	}
}

# Main stream domain - health check and index
{$STREAM_DOMAIN:stream.localhost} {
	handle /health {
		respond "OK" 200
	}

	handle {
		respond "ClaudeTorio Streams - Use c{N}.{$STREAM_DOMAIN} to access slot N" 200
	}

	log {
		output stdout
		format console
		level INFO
	}
}

# Wildcard subdomain: c{N}.stream.domain -> stream-client-{N}:3000
#                     cr{N}.stream.domain -> stream-client-replay-{N}:3000
*.{$STREAM_DOMAIN:stream.localhost} {
	tls {
		on_demand
	}

	@slot header_regexp slot Host ^c(\d+)\.
	@replay header_regexp replay Host ^cr(\d+)\.

	handle @replay {
		reverse_proxy stream-client-replay-{re.replay.1}:3000 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}

			transport http {
				response_header_timeout 0
				read_buffer 0
			}

			flush_interval -1
		}
	}

	handle @slot {
		reverse_proxy stream-client-{re.slot.1}:3000 {
			# WebSocket support for KasmVNC
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}

			transport http {
				response_header_timeout 0
				read_buffer 0
			}

			flush_interval -1
		}
	}

	log {
		output stdout
		format console
		level INFO
	}
}
